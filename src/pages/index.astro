---
const navigation = [
	{ label: 'Home', href: '#top' },
	{ label: 'Logbook', href: '#logbook' },
	{ label: 'Adventures', href: '#adventures' },
	{ label: 'Food', href: '#food' },
	{ label: 'Watch', href: '#watch' },
	{ label: 'Shop', href: '#shop' },
	{ label: 'About', href: '#about' },
];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta
			name="description"
			content="Coast2Road — a digital logbook of life on the water, the road, and everywhere in between."
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>coast2road | The Journey Matters</title>
	</head>
	<body id="top">
		<header class="site-header">
			<a class="brand" href="#top" aria-label="Coast2Road home">
				<img src="/images/coast2road-logo.svg" alt="" />
				<span class="brand-copy">
					<strong>coast<span>2</span>road</strong>
					<em>The Journey Matters</em>
				</span>
			</a>

			<nav aria-label="Main navigation">
				{navigation.map((item, index) => (
					<a class:list={['nav-link', { active: index === 0 }]} href={item.href}>
						{item.label}
					</a>
				))}
			</nav>

			<button class="menu-button" type="button" aria-label="Open navigation menu">
				<span></span><span></span><span></span>
			</button>
		</header>

		<main>
			<section class="hero" aria-labelledby="hero-title">
				<img
					class="hero-image"
					src="/images/rumo-20-marina.jpeg"
					alt="Rumo 20 moored in the marina beneath a dramatic coastal sky"
				/>
				<div class="hero-shade"></div>
				<div class="hero-content">
					<p class="eyebrow">From the coast to the road</p>
					<h1 id="hero-title">coast2road</h1>
					<p class="script">and the Places In Between</p>
					<span class="gold-rule"></span>
					<p class="intro">
						A digital logbook of life on the water,<br />
						the road, and everywhere in between.
					</p>
					<a class="primary-button" href="#logbook">
						<span aria-hidden="true">⚓</span>
						Open the Logbook
					</a>
				</div>
			</section>

			<section class="next-section" id="logbook" aria-labelledby="next-title">
				<p>Latest from the</p>
				<h2 id="next-title">LOGBOOK</h2>
				<span></span>
				<p class="coming-soon">Stories from the journey are coming aboard next.</p>
			</section>
		</main>
	</body>
</html>

<style is:global>
	:root {
		--navy: #082b4a;
		--deep-navy: #021b31;
		--gold: #c99135;
		--paper: #f7f5f0;
		--ink: #10273e;
	}

	* {
		box-sizing: border-box;
	}

	html {
		scroll-behavior: smooth;
	}

	body {
		margin: 0;
		color: var(--ink);
		background:
			radial-gradient(circle at 18% 8%, rgba(201, 145, 53, 0.07), transparent 24rem),
			var(--paper);
		font-family: "Avenir Next", Avenir, "Helvetica Neue", Arial, sans-serif;
	}

	a {
		color: inherit;
	}

	.site-header {
		position: relative;
		z-index: 10;
		display: flex;
		align-items: center;
		justify-content: space-between;
		width: min(1480px, calc(100% - 48px));
		min-height: 112px;
		margin: 0 auto;
		gap: 32px;
	}

	.brand {
		display: inline-flex;
		align-items: center;
		gap: 12px;
		flex: 0 0 auto;
		text-decoration: none;
	}

	.brand img {
		width: 76px;
		height: 76px;
		object-fit: contain;
	}

	.brand-copy {
		display: flex;
		flex-direction: column;
		line-height: 1;
	}

	.brand-copy strong {
		font-family: Georgia, "Times New Roman", serif;
		font-size: clamp(1.35rem, 2vw, 2rem);
		letter-spacing: 0.035em;
		color: var(--navy);
	}

	.brand-copy strong span {
		color: var(--gold);
	}

	.brand-copy em {
		margin-top: 8px;
		font-family: "Snell Roundhand", "Brush Script MT", cursive;
		font-size: 1rem;
		font-weight: 600;
		color: var(--deep-navy);
	}

	nav {
		display: flex;
		align-items: center;
		gap: clamp(20px, 2.25vw, 42px);
	}

	.nav-link {
		position: relative;
		padding: 44px 0 39px;
		text-decoration: none;
		text-transform: uppercase;
		font-size: 0.77rem;
		font-weight: 700;
		letter-spacing: 0.085em;
		color: var(--deep-navy);
	}

	.nav-link::after {
		position: absolute;
		right: 0;
		bottom: 30px;
		left: 0;
		height: 2px;
		background: var(--gold);
		content: "";
		opacity: 0;
		transform: scaleX(0.4);
		transition: 180ms ease;
	}

	.nav-link:hover::after,
	.nav-link.active::after {
		opacity: 1;
		transform: scaleX(1);
	}

	.menu-button {
		display: none;
		width: 44px;
		height: 44px;
		padding: 10px;
		border: 0;
		background: transparent;
	}

	.menu-button span {
		display: block;
		height: 2px;
		margin: 5px 0;
		background: var(--navy);
	}

	main {
		width: min(1480px, calc(100% - 48px));
		margin: 0 auto;
	}

	.hero {
		position: relative;
		min-height: clamp(520px, 66vh, 720px);
		overflow: hidden;
		border-radius: 4px;
		background: var(--navy);
		box-shadow: 0 20px 60px rgba(3, 29, 51, 0.15);
		isolation: isolate;
	}

	.hero-image,
	.hero-shade {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
	}

	.hero-image {
		z-index: -2;
		object-fit: cover;
		object-position: 50% 68%;
	}

	.hero-shade {
		z-index: -1;
		background:
			linear-gradient(90deg, rgba(0, 18, 34, 0.88) 0%, rgba(0, 23, 42, 0.66) 37%, rgba(0, 24, 44, 0.12) 72%),
			linear-gradient(0deg, rgba(0, 15, 28, 0.28), transparent 55%);
	}

	.hero-content {
		display: flex;
		min-height: inherit;
		width: min(660px, 56%);
		padding: clamp(64px, 8vw, 112px) clamp(34px, 5vw, 80px);
		flex-direction: column;
		align-items: flex-start;
		justify-content: center;
		color: white;
		text-shadow: 0 2px 18px rgba(0, 0, 0, 0.28);
	}

	.eyebrow {
		margin: 0 0 8px;
		text-transform: uppercase;
		font-size: 0.8rem;
		font-weight: 700;
		letter-spacing: 0.22em;
		color: #f5d296;
	}

	h1 {
		margin: 0;
		font-family: Georgia, "Times New Roman", serif;
		font-size: clamp(3.6rem, 6vw, 6.1rem);
		font-weight: 700;
		line-height: 0.95;
		letter-spacing: -0.035em;
	}

	.script {
		margin: 18px 0 0;
		font-family: "Snell Roundhand", "Brush Script MT", cursive;
		font-size: clamp(1.8rem, 3.5vw, 3.4rem);
		line-height: 1.1;
		color: #f2c477;
	}

	.gold-rule {
		width: 42px;
		height: 3px;
		margin: 28px 0 20px;
		background: var(--gold);
	}

	.intro {
		margin: 0;
		font-size: clamp(1rem, 1.5vw, 1.28rem);
		line-height: 1.65;
	}

	.primary-button {
		display: inline-flex;
		align-items: center;
		gap: 13px;
		margin-top: 30px;
		padding: 16px 24px;
		border: 1px solid rgba(255, 255, 255, 0.85);
		text-decoration: none;
		text-transform: uppercase;
		font-size: 0.78rem;
		font-weight: 800;
		letter-spacing: 0.12em;
		background: rgba(4, 40, 69, 0.9);
		box-shadow: 0 8px 24px rgba(0, 0, 0, 0.18);
		transition: 180ms ease;
	}

	.primary-button:hover {
		background: var(--gold);
		transform: translateY(-2px);
	}

	.primary-button span {
		font-size: 1.2rem;
	}

	.next-section {
		padding: 58px 20px 80px;
		text-align: center;
	}

	.next-section > p:first-child {
		margin: 0;
		font-family: "Snell Roundhand", "Brush Script MT", cursive;
		font-size: 1.5rem;
		color: var(--navy);
	}

	.next-section h2 {
		margin: 0;
		font-family: Georgia, "Times New Roman", serif;
		font-size: clamp(2rem, 4vw, 3.25rem);
		letter-spacing: 0.04em;
		color: var(--navy);
	}

	.next-section > span {
		display: block;
		width: 52px;
		height: 2px;
		margin: 18px auto 24px;
		background: var(--gold);
	}

	.coming-soon {
		margin: 0;
		color: #526476;
	}

	@media (max-width: 980px) {
		nav {
			display: none;
		}

		.menu-button {
			display: block;
		}

		.hero-content {
			width: min(680px, 78%);
		}
	}

	@media (max-width: 640px) {
		.site-header,
		main {
			width: min(100% - 28px, 1480px);
		}

		.site-header {
			min-height: 90px;
		}

		.brand img {
			width: 58px;
			height: 58px;
		}

		.brand-copy strong {
			font-size: 1.25rem;
		}

		.brand-copy em {
			font-size: 0.8rem;
		}

		.hero {
			min-height: 610px;
		}

		.hero-image {
			object-position: 57% 65%;
		}

		.hero-shade {
			background: linear-gradient(90deg, rgba(0, 18, 34, 0.9), rgba(0, 23, 42, 0.5));
		}

		.hero-content {
			width: 100%;
			padding: 54px 26px;
			justify-content: flex-end;
		}

		h1 {
			font-size: clamp(2.5rem, 11vw, 3.2rem);
		}

		.script {
			font-size: 1.95rem;
		}
	}
</style>
