---
const navigation = [
	{ label: 'Home', href: '#top' },
	{ label: 'Logbook', href: '#logbook' },
	{ label: 'Adventures', href: '#adventures' },
	{ label: 'Food', href: '#food' },
	{ label: 'Watch', href: '#watch' },
	{ label: 'Shop', href: '#shop' },
	{ label: 'About', href: '#about' },
];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta
			name="description"
			content="Coast2Road — a digital logbook of life on the water, the road, and everywhere in between."
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>coast2road | The Journey Matters</title>
	</head>
	<body id="top">
		<header class="site-header">
			<a class="brand" href="#top" aria-label="Coast2Road home">
				<img src="/images/coast2road-logo.svg" alt="" />
				<span class="brand-copy">
					<strong>coast<span>2</span>road</strong>
					<em>The Journey Matters</em>
				</span>
			</a>

			<nav aria-label="Main navigation">
				{navigation.map((item, index) => (
					<a class:list={['nav-link', { active: index === 0 }]} href={item.href}>
						{item.label}
					</a>
				))}
			</nav>

			<button class="menu-button" type="button" aria-label="Open navigation menu">
				<span></span><span></span><span></span>
			</button>
		</header>

		<main>
			<section class="hero" aria-labelledby="hero-title">
				<img
					class="hero-image"
					src="/images/rumo-20-marina.jpeg"
					alt="Rumo 20 moored in the marina beneath a dramatic coastal sky"
				/>
				<div class="hero-shade"></div>
				<div class="hero-content">
					<p class="eyebrow">From the coast to the road</p>
					<h1 id="hero-title">coast2road</h1>
					<p class="script">and the Places In Between</p>
					<span class="gold-rule"></span>
					<p class="intro">
						A digital logbook of life on the water,<br />
						the road, and everywhere in between.
					</p>
					<a class="primary-button" href="#logbook">
						<span aria-hidden="true">⚓</span>
						Open the Logbook
					</a>
				</div>
			</section>

			<section class="journey-grid" id="logbook" aria-label="Latest from Coast2Road">
				<article class="panel logbook-panel">
					<header class="panel-heading">
						<p>Latest from the</p>
						<h2>LOGBOOK</h2>
					</header>
					<div class="story-card">
						<div class="story-image">
							<img
								src="/images/toulouse-garonne.png"
								alt="The Garonne River and waterfront in Toulouse, France"
							/>
							<span>● Toulouse, France</span>
						</div>
						<div class="story-copy">
							<h3>A Week in Toulouse</h3>
							<p>Airbus, riverboats, local markets, and one unforgettable half chicken.</p>
							<div class="story-meta">
								<span>▣ July 12, 2026</span>
								<span>◷ 3 min read</span>
								<a href="#article" aria-label="Read A Week in Toulouse">→</a>
							</div>
						</div>
					</div>
				</article>

				<article class="panel video-panel" id="watch">
					<header class="panel-heading">
						<h2>FEATURED VIDEO</h2>
					</header>
					<div class="video-card">
						<div class="video-copy">
							<p class="panel-kicker">On the water</p>
							<h3>Dolphins at the Bow</h3>
							<p>Some days the ocean gives you a show.</p>
						</div>
						<a class="video-image" href="#video" aria-label="Watch Dolphins at the Bow">
							<img src="/images/dolphin-preview.png" alt="A dolphin surfacing beside the vessel" />
							<span class="play-button" aria-hidden="true">▶</span>
						</a>
						<a class="watch-button" href="#video"><span>▶</span> Watch now</a>
					</div>
				</article>

				<article class="panel weather-panel">
					<header class="panel-heading">
						<h2>CURRENT WEATHER</h2>
					</header>
					<div class="weather-card">
						<div class="weather-location">● Galveston, TX</div>
						<div class="weather-now">
							<div>
								<strong>82<span>°F</span></strong>
								<p>Partly cloudy</p>
							</div>
							<div class="weather-icon" aria-label="Partly cloudy">☀︎<span>☁</span></div>
						</div>
						<div class="forecast">
							<div><span>Fri</span><b>☀︎</b><strong>84°</strong></div>
							<div><span>Sat</span><b>☁</b><strong>83°</strong></div>
							<div><span>Sun</span><b>☀︎</b><strong>85°</strong></div>
						</div>
						<div class="weather-detail">
							<span>≋ Wind<br /><strong>SE 12 kt</strong></span>
							<span>◒ Sunset<br /><strong>8:18 pm</strong></span>
						</div>
						<div class="tide-strip" aria-label="Upcoming tide preview">
							<div class="tide-heading">
								<span class="tide-icon" aria-hidden="true">≈</span>
								<strong>Next tides</strong>
							</div>
							<div class="tide-event">
								<span aria-hidden="true">↑</span>
								<div><small>High</small><strong>11:42 am</strong></div>
								<em>1.4 ft</em>
							</div>
							<div class="tide-event">
								<span aria-hidden="true">↓</span>
								<div><small>Low</small><strong>8:16 pm</strong></div>
								<em>0.5 ft</em>
							</div>
						</div>
						<a
							class="radar-link"
							href="https://radar.weather.gov/region/tx/standard"
							target="_blank"
							rel="noopener noreferrer"
						>
							<span aria-hidden="true">◉</span> View weather radar <span aria-hidden="true">→</span>
						</a>
						<p class="weather-note">Design preview — live weather connection coming next.</p>
					</div>
				</article>
			</section>
		</main>
	</body>
</html>

<style is:global>
	:root {
		--navy: #082b4a;
		--deep-navy: #021b31;
		--gold: #c99135;
		--paper: #f7f5f0;
		--ink: #10273e;
	}

	* {
		box-sizing: border-box;
	}

	html {
		scroll-behavior: smooth;
	}

	body {
		margin: 0;
		color: var(--ink);
		background:
			radial-gradient(circle at 18% 8%, rgba(201, 145, 53, 0.07), transparent 24rem),
			var(--paper);
		font-family: "Avenir Next", Avenir, "Helvetica Neue", Arial, sans-serif;
	}

	a {
		color: inherit;
	}

	.site-header {
		position: relative;
		z-index: 10;
		display: flex;
		align-items: center;
		justify-content: space-between;
		width: min(1480px, calc(100% - 48px));
		min-height: 112px;
		margin: 0 auto;
		gap: 32px;
	}

	.brand {
		display: inline-flex;
		align-items: center;
		gap: 12px;
		flex: 0 0 auto;
		text-decoration: none;
	}

	.brand img {
		width: 76px;
		height: 76px;
		object-fit: contain;
	}

	.brand-copy {
		display: flex;
		flex-direction: column;
		line-height: 1;
	}

	.brand-copy strong {
		font-family: Georgia, "Times New Roman", serif;
		font-size: clamp(1.35rem, 2vw, 2rem);
		font-style: italic;
		letter-spacing: 0.035em;
		color: var(--navy);
		transform: skewX(-4deg);
		transform-origin: left center;
	}

	.brand-copy strong span {
		color: var(--gold);
	}

	.brand-copy em {
		margin-top: 8px;
		font-family: "Snell Roundhand", "Brush Script MT", cursive;
		font-size: 1rem;
		font-weight: 600;
		color: var(--deep-navy);
	}

	nav {
		display: flex;
		align-items: center;
		gap: clamp(20px, 2.25vw, 42px);
	}

	.nav-link {
		position: relative;
		padding: 44px 0 39px;
		text-decoration: none;
		text-transform: uppercase;
		font-size: 0.77rem;
		font-weight: 700;
		letter-spacing: 0.085em;
		color: var(--deep-navy);
	}

	.nav-link::after {
		position: absolute;
		right: 0;
		bottom: 30px;
		left: 0;
		height: 2px;
		background: var(--gold);
		content: "";
		opacity: 0;
		transform: scaleX(0.4);
		transition: 180ms ease;
	}

	.nav-link:hover::after,
	.nav-link.active::after {
		opacity: 1;
		transform: scaleX(1);
	}

	.menu-button {
		display: none;
		width: 44px;
		height: 44px;
		padding: 10px;
		border: 0;
		background: transparent;
	}

	.menu-button span {
		display: block;
		height: 2px;
		margin: 5px 0;
		background: var(--navy);
	}

	main {
		width: min(1480px, calc(100% - 48px));
		margin: 0 auto;
	}

	.hero {
		position: relative;
		min-height: clamp(520px, 66vh, 720px);
		overflow: hidden;
		border-radius: 4px;
		background: var(--navy);
		box-shadow: 0 20px 60px rgba(3, 29, 51, 0.15);
		isolation: isolate;
	}

	.hero-image,
	.hero-shade {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
	}

	.hero-image {
		z-index: -2;
		object-fit: cover;
		object-position: 50% 68%;
	}

	.hero-shade {
		z-index: -1;
		background:
			linear-gradient(90deg, rgba(0, 18, 34, 0.88) 0%, rgba(0, 23, 42, 0.66) 37%, rgba(0, 24, 44, 0.12) 72%),
			linear-gradient(0deg, rgba(0, 15, 28, 0.28), transparent 55%);
	}

	.hero-content {
		display: flex;
		min-height: inherit;
		width: min(660px, 56%);
		padding: clamp(64px, 8vw, 112px) clamp(34px, 5vw, 80px);
		flex-direction: column;
		align-items: flex-start;
		justify-content: center;
		color: white;
		text-shadow: 0 2px 18px rgba(0, 0, 0, 0.28);
	}

	.eyebrow {
		margin: 0 0 8px;
		text-transform: uppercase;
		font-size: 0.8rem;
		font-weight: 700;
		letter-spacing: 0.22em;
		color: #f5d296;
	}

	h1 {
		margin: 0;
		font-family: Georgia, "Times New Roman", serif;
		font-size: clamp(3.6rem, 6vw, 6.1rem);
		font-weight: 700;
		font-style: italic;
		line-height: 0.95;
		letter-spacing: -0.035em;
		transform: skewX(-4deg);
		transform-origin: left center;
	}

	.script {
		margin: 18px 0 0;
		text-transform: uppercase;
		font-family: "Avenir Next", Avenir, "Helvetica Neue", Arial, sans-serif;
		font-size: clamp(0.75rem, 1.25vw, 0.95rem);
		font-weight: 700;
		line-height: 1.5;
		letter-spacing: 0.22em;
		color: #f5d296;
	}

	.gold-rule {
		width: 42px;
		height: 3px;
		margin: 28px 0 20px;
		background: var(--gold);
	}

	.intro {
		margin: 0;
		font-size: clamp(1rem, 1.5vw, 1.28rem);
		line-height: 1.65;
	}

	.primary-button {
		display: inline-flex;
		align-items: center;
		gap: 13px;
		margin-top: 30px;
		padding: 16px 24px;
		border: 1px solid rgba(255, 255, 255, 0.85);
		text-decoration: none;
		text-transform: uppercase;
		font-size: 0.78rem;
		font-weight: 800;
		letter-spacing: 0.12em;
		background: rgba(4, 40, 69, 0.9);
		box-shadow: 0 8px 24px rgba(0, 0, 0, 0.18);
		transition: 180ms ease;
	}

	.primary-button:hover {
		background: var(--gold);
		transform: translateY(-2px);
	}

	.primary-button span {
		font-size: 1.2rem;
	}

	.journey-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: clamp(20px, 2.5vw, 38px);
		padding: 64px 10px 90px;
	}

	.panel {
		min-width: 0;
	}

	.panel-heading {
		min-height: 92px;
		text-align: center;
	}

	.panel-heading p {
		margin: 0;
		font-family: "Snell Roundhand", "Brush Script MT", cursive;
		font-size: 1.5rem;
		line-height: 1;
		color: var(--navy);
	}

	.panel-heading h2 {
		margin: 5px 0 22px;
		font-family: Georgia, "Times New Roman", serif;
		font-size: clamp(1.55rem, 2.3vw, 2.45rem);
		line-height: 1;
		letter-spacing: 0.035em;
		color: var(--navy);
	}

	.story-card,
	.video-card,
	.weather-card {
		height: 520px;
		overflow: hidden;
		border: 1px solid rgba(8, 43, 74, 0.11);
		border-radius: 4px;
		background: #fff;
		box-shadow: 0 12px 35px rgba(3, 29, 51, 0.08);
	}

	.story-image {
		position: relative;
		height: 245px;
		overflow: hidden;
	}

	.story-image img,
	.video-image img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.story-image img {
		object-position: 22% 28%;
	}

	.story-image > span {
		position: absolute;
		top: 0;
		left: 0;
		padding: 9px 13px;
		text-transform: uppercase;
		font-size: 0.67rem;
		font-weight: 800;
		letter-spacing: 0.08em;
		color: white;
		background: var(--navy);
	}

	.story-copy {
		display: flex;
		height: 275px;
		padding: 25px;
		flex-direction: column;
	}

	.story-copy h3,
	.video-copy h3 {
		margin: 0;
		font-family: Georgia, "Times New Roman", serif;
		font-size: 1.65rem;
		color: var(--navy);
	}

	.story-copy > p {
		margin: 14px 0;
		font-size: 0.98rem;
		line-height: 1.65;
		color: #334c62;
	}

	.story-meta {
		display: flex;
		align-items: center;
		margin-top: auto;
		gap: 14px;
		text-transform: uppercase;
		font-size: 0.64rem;
		font-weight: 700;
		letter-spacing: 0.045em;
		color: var(--navy);
	}

	.story-meta a {
		margin-left: auto;
		text-decoration: none;
		font-size: 1.6rem;
	}

	.video-card {
		display: flex;
		padding: 25px;
		flex-direction: column;
		color: white;
		background:
			radial-gradient(circle at 80% 20%, rgba(39, 116, 164, 0.36), transparent 45%),
			linear-gradient(145deg, #072e4d, #011b30);
	}

	.video-copy {
		margin-bottom: 20px;
	}

	.panel-kicker {
		margin: 0 0 7px;
		text-transform: uppercase;
		font-size: 0.67rem;
		font-weight: 800;
		letter-spacing: 0.16em;
		color: #e2b86e;
	}

	.video-copy h3 {
		font-size: 1.8rem;
		color: white;
	}

	.video-copy > p:last-child {
		margin: 12px 0 0;
		line-height: 1.55;
		color: #d9e3ec;
	}

	.video-image {
		position: relative;
		display: block;
		height: 255px;
		overflow: hidden;
		border: 1px solid rgba(255, 255, 255, 0.5);
	}

	.video-image img {
		filter: saturate(0.75) contrast(1.08);
	}

	.play-button {
		position: absolute;
		top: 50%;
		left: 50%;
		display: grid;
		width: 74px;
		height: 74px;
		border: 3px solid white;
		border-radius: 50%;
		place-items: center;
		color: white;
		background: rgba(2, 27, 49, 0.48);
		transform: translate(-50%, -50%);
	}

	.watch-button {
		display: inline-flex;
		align-items: center;
		align-self: flex-start;
		gap: 10px;
		margin-top: auto;
		padding: 12px 18px;
		border: 1px solid rgba(255, 255, 255, 0.78);
		text-decoration: none;
		text-transform: uppercase;
		font-size: 0.72rem;
		font-weight: 800;
		letter-spacing: 0.1em;
	}

	.weather-card {
		display: flex;
		flex-direction: column;
	}

	.weather-location {
		padding: 24px 25px 8px;
		text-transform: uppercase;
		font-size: 0.75rem;
		font-weight: 800;
		letter-spacing: 0.08em;
		color: var(--navy);
	}

	.weather-now {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 10px 25px 22px;
	}

	.weather-now strong {
		font-family: Georgia, "Times New Roman", serif;
		font-size: 4.1rem;
		font-weight: 400;
		line-height: 1;
		color: var(--navy);
	}

	.weather-now strong span {
		font-size: 1.7rem;
	}

	.weather-now p {
		margin: 8px 0 0;
		text-transform: uppercase;
		font-size: 0.72rem;
		font-weight: 800;
		letter-spacing: 0.08em;
	}

	.weather-icon {
		position: relative;
		font-size: 4.4rem;
		line-height: 1;
		color: #dea339;
	}

	.weather-icon span {
		position: absolute;
		right: -11px;
		bottom: -2px;
		font-size: 3.8rem;
		color: #6f8ca4;
	}

	.forecast {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		border-top: 1px solid #dfe4e7;
		border-bottom: 1px solid #dfe4e7;
	}

	.forecast div {
		display: flex;
		align-items: center;
		padding: 17px 8px;
		border-right: 1px solid #dfe4e7;
		flex-direction: column;
		gap: 6px;
	}

	.forecast div:last-child {
		border-right: 0;
	}

	.forecast span {
		text-transform: uppercase;
		font-size: 0.64rem;
		font-weight: 800;
	}

	.forecast b {
		font-size: 1.7rem;
		font-weight: 400;
		color: #d9992b;
	}

	.forecast strong {
		font-size: 0.95rem;
		color: var(--navy);
	}

	.weather-detail {
		display: grid;
		grid-template-columns: 1fr 1fr;
		padding: 20px 25px;
	}

	.weather-detail span {
		text-transform: uppercase;
		font-size: 0.65rem;
		line-height: 1.65;
		color: #617487;
	}

	.weather-detail strong {
		color: var(--navy);
	}

	.tide-strip {
		margin: 0 18px;
		padding: 12px 0;
		display: grid;
		grid-template-columns: 0.9fr 1fr 1fr;
		align-items: center;
		border-top: 1px solid #dfe4e7;
		border-bottom: 1px solid #dfe4e7;
	}

	.tide-heading {
		display: flex;
		align-items: center;
		gap: 7px;
		text-transform: uppercase;
		font-size: 0.62rem;
		letter-spacing: 0.08em;
		color: var(--navy);
	}

	.tide-icon {
		display: grid;
		place-items: center;
		width: 25px;
		height: 25px;
		border-radius: 50%;
		background: #e7f0f3;
		color: #167c91;
		font-size: 1rem;
		font-weight: 800;
	}

	.tide-event {
		display: grid;
		grid-template-columns: auto 1fr;
		column-gap: 7px;
		align-items: center;
		padding-left: 12px;
		border-left: 1px solid #dfe4e7;
		color: #167c91;
	}

	.tide-event > span {
		grid-row: 1 / span 2;
		font-size: 1.2rem;
		font-weight: 800;
	}

	.tide-event div {
		display: flex;
		flex-direction: column;
		line-height: 1.15;
	}

	.tide-event small {
		text-transform: uppercase;
		font-size: 0.54rem;
		letter-spacing: 0.08em;
		color: #718392;
	}

	.tide-event strong {
		font-size: 0.72rem;
		color: var(--navy);
	}

	.tide-event em {
		grid-column: 2;
		font-size: 0.58rem;
		font-style: normal;
		color: #718392;
	}

	.radar-link {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 7px;
		margin: 13px 18px 8px;
		padding: 9px 12px;
		border: 1px solid #b9d1d7;
		border-radius: 4px;
		color: #116b80;
		text-decoration: none;
		text-transform: uppercase;
		font-size: 0.62rem;
		font-weight: 800;
		letter-spacing: 0.07em;
		transition: background-color 160ms ease, color 160ms ease;
	}

	.radar-link:hover {
		background: #116b80;
		color: white;
	}

	.weather-note {
		margin: auto 20px 12px;
		text-align: center;
		font-size: 0.62rem;
		color: #7b8995;
	}

	@media (max-width: 980px) {
		nav {
			display: none;
		}

		.menu-button {
			display: block;
		}

		.hero-content {
			width: min(680px, 78%);
		}

		.journey-grid {
			grid-template-columns: 1fr 1fr;
		}

		.weather-panel {
