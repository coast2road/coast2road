---
const navigation = [
	{ label: 'Home', href: '#top' },
	{ label: 'Logbook', href: '#logbook' },
	{ label: 'Adventures', href: '#adventures' },
	{ label: 'Food', href: '#food' },
	{ label: 'Watch', href: '#watch' },
	{ label: 'Shop', href: '#shop' },
	{ label: 'About', href: '#about' },
];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta
			name="description"
			content="Coast2Road — a digital logbook of life on the water, the road, and everywhere in between."
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>coast2road | The Journey Matters</title>
	</head>
	<body id="top">
		<header class="site-header">
			<a class="brand" href="#top" aria-label="Coast2Road home">
				<img src="/images/coast2road-logo.svg" alt="" />
				<span class="brand-copy">
					<strong>coast<span>2</span>road</strong>
					<em>The Journey Matters</em>
				</span>
			</a>

			<nav aria-label="Main navigation">
				{navigation.map((item, index) => (
					<a class:list={['nav-link', { active: index === 0 }]} href={item.href}>
						{item.label}
					</a>
				))}
			</nav>

			<button class="menu-button" type="button" aria-label="Open navigation menu">
				<span></span><span></span><span></span>
			</button>
		</header>

		<main>
			<section class="hero" aria-labelledby="hero-title">
				<img
					class="hero-image"
					src="/images/rumo-20-marina.jpeg"
					alt="Rumo 20 moored in the marina beneath a dramatic coastal sky"
				/>
				<div class="hero-shade"></div>
				<div class="hero-content">
					<p class="eyebrow">From the coast to the road</p>
					<h1 id="hero-title">coast2road</h1>
					<p class="script">and the Places In Between</p>
					<span class="gold-rule"></span>
					<p class="intro">
						A digital logbook of life on the water,<br />
						the road, and everywhere in between.
					</p>
					<a class="primary-button" href="#logbook">
						<span aria-hidden="true">⚓</span>
						Open the Logbook
					</a>
				</div>
			</section>

			<section class="journey-grid" id="logbook" aria-label="Latest from Coast2Road">
				<article class="panel logbook-panel">
					<header class="panel-heading">
						<p>Latest from the</p>
						<h2>LOGBOOK</h2>
					</header>
					<div class="story-card">
						<div class="story-image">
							<img
								src="/images/toulouse-garonne.png"
								alt="The Garonne River and waterfront in Toulouse, France"
							/>
							<span>● Toulouse, France</span>
						</div>
						<div class="story-copy">
							<h3>A Week in Toulouse</h3>
							<p>Airbus, riverboats, local markets, and one unforgettable half chicken.</p>
							<div class="story-meta">
								<span>▣ July 12, 2026</span>
								<span>◷ 3 min read</span>
								<a href="#article" aria-label="Read A Week in Toulouse">→</a>
							</div>
						</div>
					</div>
				</article>

				<article class="panel video-panel" id="watch">
					<header class="panel-heading">
						<h2>FEATURED VIDEO</h2>
					</header>
					<div class="video-card">
						<div class="video-copy">
							<p class="panel-kicker">On the water</p>
							<h3>Dolphins at the Bow</h3>
							<p>Some days the ocean gives you a show.</p>
						</div>
						<a class="video-image" href="#video" aria-label="Watch Dolphins at the Bow">
							<img src="/images/dolphin-preview.png" alt="A dolphin surfacing beside the vessel" />
							<span class="play-button" aria-hidden="true">▶</span>
						</a>
						<a class="watch-button" href="#video"><span>▶</span> Watch now</a>
					</div>
				</article>

				<article class="panel weather-panel">
					<header class="panel-heading">
						<h2>CURRENT WEATHER</h2>
					</header>
					<div class="weather-card">
						<div class="weather-location">● Galveston, TX</div>
						<div class="weather-now">
							<div>
								<strong>82<span>°F</span></strong>
								<p>Partly cloudy</p>
							</div>
							<div class="weather-icon" aria-label="Partly cloudy">☀︎<span>☁</span></div>
						</div>
						<div class="forecast">
							<div><span>Fri</span><b>☀︎</b><strong>84°</strong></div>
							<div><span>Sat</span><b>☁</b><strong>83°</strong></div>
							<div><span>Sun</span><b>☀︎</b><strong>85°</strong></div>
						</div>
						<div class="weather-detail">
							<span>≋ Wind<br /><strong>SE 12 kt</strong></span>
							<span>◒ Sunset<br /><strong>8:18 pm</strong></span>
						</div>
						<div class="tide-strip" aria-label="Upcoming tide preview">
							<div class="tide-heading">
								<span class="tide-icon" aria-hidden="true">≈</span>
								<strong>Next tides</strong>
							</div>
							<div class="tide-event">
								<span aria-hidden="true">↑</span>
								<div><small>High</small><strong>11:42 am</strong></div>
								<em>1.4 ft</em>
							</div>
							<div class="tide-event">
								<span aria-hidden="true">↓</span>
								<div><small>Low</small><strong>8:16 pm</strong></div>
								<em>0.5 ft</em>
							</div>
						</div>
						<a
							class="radar-link"
							href="https://radar.weather.gov/region/tx/standard"
							target="_blank"
							rel="noopener noreferrer"
						>
							<span aria-hidden="true">◉</span> View weather radar <span aria-hidden="true">→</span>
						</a>
						<p class="weather-note">Design preview — live weather connection coming next.</p>
					</div>
				</article>
			</section>

			<section class="course-section" id="adventures" aria-labelledby="course-title">
				<article class="discovery-card" id="food">
					<p class="discovery-label"><span></span>This week’s discovery</p>
					<img src="/images/pasteis-de-belem.png" alt="Pastéis de Belém served in Lisbon, Portugal" />
					<div class="discovery-copy">
						<h2>Pastéis de Belém</h2>
						<p class="discovery-location">● Lisbon, Portugal</p>
						<p>Warm custard, flaky crust, and a recipe older than the United States.</p>
						<a href="#story">Read the story <span aria-hidden="true">→</span></a>
					</div>
				</article>

				<div class="course-content">
					<header class="section-title">
						<span></span>
						<div>
							<h2 id="course-title">Choose Your Course</h2>
							<p>Explore by category</p>
						</div>
						<span></span>
					</header>

					<div class="category-grid">
						<a class="category-card" href="#maritime">
							<svg viewBox="0 0 48 48" aria-hidden="true"><path d="M24 5v31M18 11h12M16 19h16M10 28c2 8 7 13 14 15 7-2 12-7 14-15M10 28h8M38 28h-8M21 5a3 3 0 1 0 6 0 3 3 0 0 0-6 0Z"/></svg>
							<span>Maritime</span>
						</a>
						<a class="category-card" href="#rv-travel">
							<svg viewBox="0 0 48 48" aria-hidden="true"><path d="M6 12h31c3 0 5 2 5 5v20H6V12ZM11 17h12v9H11zM28 17h9v9h-9zM31 31h6M12 37a4 4 0 1 0 8 0M31 37a4 4 0 1 0 8 0M6 29H3v6h3"/></svg>
							<span>RV Travel</span>
						</a>
						<a class="category-card" href="#food">
							<svg viewBox="0 0 48 48" aria-hidden="true"><path d="M14 5v14M9 5v9c0 4 2 6 5 6s5-2 5-6V5M14 20v23M31 5v38M31 5c7 5 8 15 0 20"/></svg>
							<span>Food</span>
						</a>
						<a class="category-card" href="#museums">
							<svg viewBox="0 0 48 48" aria-hidden="true"><path d="M5 18h38L24 6 5 18ZM9 21v17M18 21v17M30 21v17M39 21v17M5 42h38M7 38h34"/></svg>
							<span>Museums</span>
						</a>
						<a class="category-card" href="#travel">
							<svg viewBox="0 0 48 48" aria-hidden="true"><circle cx="24" cy="24" r="18"/><path d="M6 24h36M24 6c6 5 9 11 9 18s-3 13-9 18c-6-5-9-11-9-18s3-13 9-18Z"/></svg>
							<span>Travel</span>
						</a>
						<a class="category-card" href="#nature">
							<svg viewBox="0 0 48 48" aria-hidden="true"><path d="M9 35c2-13 10-22 27-26 1 17-7 28-27 26ZM9 35c7-8 14-14 23-20M8 40l5-7M35 33a8 8 0 0 1 7 7M39 25v4M29 35h4"/></svg>
							<span>Nature</span>
						</a>
						<a class="category-card" href="#boating">
							<svg viewBox="0 0 48 48" aria-hidden="true"><path d="M7 27h34l-5 10H13L7 27ZM15 27l3-9h15l4 9M22 18v-7h7v7M5 42c4-3 8-3 12 0 4-3 8-3 12 0 4-3 8-3 12 0"/></svg>
							<span>Boating</span>
						</a>
						<a class="category-card" href="#aviation">
							<svg viewBox="0 0 48 48" aria-hidden="true"><path d="m5 27 16-5V9c0-3 1-5 3-7 2 2 3 4 3 7v13l16 5v4l-16-2v9l6 4v3l-9-2-9 2v-3l6-4v-9L5 31v-4Z"/></svg>
							<span>Aviation</span>
						</a>
					</div>
					<a class="all-categories" href="#categories">Explore all categories <span aria-hidden="true">→</span></a>
				</div>
			</section>

			<section class="map-preview" aria-labelledby="map-title">
				<div class="map-copy">
					<p class="map-script">Coming Soon</p>
					<h2 id="map-title">The Logbook Map</h2>
					<p>An interactive map of everywhere we’ve been—and the stories that came with each place.</p>
					<a href="#map">Explore the map (soon)</a>
				</div>

				<div class="world-map" aria-label="Preview map showing Coast2Road destinations">
					<svg class="map-art" viewBox="0 0 900 390" role="img" aria-label="World map">
						<g class="continents">
							<path d="M65 83 108 45l76-20 66 18 40 35-8 41-38 10-18 33-42 12-25 43-30-16-5-43-40-17-27-34Z"/>
							<path d="m220 208 40 20 23 57-17 62-29 34-18-55-20-41 3-53Z"/>
							<path d="m405 72 55-32 80 13 45 36-25 27-66-8-25 26-47-14-35-26Z"/>
							<path d="m468 142 56-12 49 31 11 65-25 70-38 48-32-53-13-58-28-39Z"/>
							<path d="m563 74 69-32 88 19 74 48-20 37-49-5-33 34-67-9-38-31Z"/>
							<path d="m728 269 45-25 55 21 17 45-41 29-59-11-27-32Z"/>
							<path d="m348 334 16-14 14 18-17 14Z"/>
							<path d="m814 165 19-17 14 22-18 16Z"/>
						</g>
						<path class="route-line" d="M177 143 C245 88 333 102 425 111 S555 101 618 112"/>
					</svg>

					<div class="map-pin pin-galveston"><span></span><b>Galveston</b></div>
					<div class="map-pin pin-philadelphia"><span></span><b>Philadelphia</b></div>
					<div class="map-pin pin-lisbon"><span></span><b>Lisbon</b></div>
					<div class="map-pin pin-toulouse"><span></span><b>Toulouse</b></div>
					<div class="map-pin pin-brazil"><span></span><b>Brazil</b></div>
					<p class="map-motto">Home. Explore.<br />Discover the story.</p>
				</div>
			</section>
		</main>

		<footer class="site-footer" id="about">
			<div class="footer-inner">
				<div class="footer-brand">
					<a href="#top" aria-label="Return to the Coast2Road homepage">
						<img src="/images/coast2road-compass.svg" alt="" />
						<span><strong>coast<span>2</span>road</strong><em>The Journey Matters</em></span>
					</a>
					<p>Documenting authentic experiences from the water, the road, and the places in between.</p>
					<a class="footer-email" href="mailto:hello@coast2road.com">
						<span aria-hidden="true">✉</span>
						<strong>Email us:</strong>
						hello@coast2road.com
					</a>
				</div>

				<nav class="footer-column" aria-label="Explore">
					<h2>Explore</h2>
					<a href="#logbook">Logbook</a>
					<a href="#adventures">Adventures</a>
					<a href="#food">Food</a>
					<a href="#watch">Watch</a>
				</nav>

				<nav class="footer-column" aria-label="About Coast2Road">
					<h2>About</h2>
					<a href="#about">About Coast2Road</a>
					<a href="#philosophy">Our Philosophy</a>
					<a href="mailto:hello@coast2road.com">Contact</a>
				</nav>

				<nav class="footer-column" id="shop" aria-label="Shop">
					<h2>Shop</h2>
					<a href="#apparel">Apparel</a>
					<a href="#accessories">Accessories</a>
					<a href="#cookbook">Cookbook</a>
				</nav>

				<div class="footer-connect">
					<h2>Stay Connected</h2>
					<p>Updates on new stories, videos, recipes, and adventures.</p>
					<div class="newsletter-preview" aria-label="Newsletter sign-up coming soon">
						<span>Your email address</span>
						<b aria-hidden="true">➤</b>
					</div>
					<small>Newsletter coming soon</small>
					<p class="follow-label">Follow us:</p>
					<div class="social-links" aria-label="Coast2Road social media">
						<a href="#facebook" aria-label="Facebook">f</a>
						<a href="#instagram" aria-label="Instagram">◎</a>
						<a href="#youtube" aria-label="YouTube">▶</a>
					</div>
				</div>
			</div>

			<div class="footer-bottom">
				<p>© 2026 Coast2Road, LLC</p>
				<p class="keep-exploring"><span>✥</span> Keep Exploring.</p>
				<div><a href="#privacy">Privacy Policy</a><span>|</span><a href="#terms">Terms of Use</a></div>
			</div>
		</footer>
	</body>
</html>

<style is:global>
	:root {
		--navy: #082b4a;
		--deep-navy: #021b31;
		--gold: #c99135;
		--paper: #f7f5f0;
		--ink: #10273e;
	}

	* {
		box-sizing: border-box;
	}

	html {
		scroll-behavior: smooth;
	}

	body {
		margin: 0;
		color: var(--ink);
		background:
			radial-gradient(circle at 18% 8%, rgba(201, 145, 53, 0.07), transparent 24rem),
			var(--paper);
		font-family: "Avenir Next", Avenir, "Helvetica Neue", Arial, sans-serif;
	}

	a {
		color: inherit;
	}

	.site-header {
		position: relative;
		z-index: 10;
		display: flex;
		align-items: center;
		justify-content: space-between;
		width: min(1480px, calc(100% - 48px));
		min-height: 112px;
		margin: 0 auto;
		gap: 32px;
	}

	.brand {
		display: inline-flex;
		align-items: center;
		gap: 12px;
		flex: 0 0 auto;
		text-decoration: none;
	}

	.brand img {
		width: 76px;
		height: 76px;
		object-fit: contain;
	}

	.brand-copy {
		display: flex;
		flex-direction: column;
		line-height: 1;
	}

	.brand-copy strong {
		font-family: Georgia, "Times New Roman", serif;
		font-size: clamp(1.35rem, 2vw, 2rem);
		font-style: italic;
		letter-spacing: 0.035em;
		color: var(--navy);
		transform: skewX(-4deg);
		transform-origin: left center;
	}

	.brand-copy strong span {
		color: var(--gold);
	}

	.brand-copy em {
		margin-top: 8px;
		font-family: "Snell Roundhand", "Brush Script MT", cursive;
		font-size: 1rem;
		font-weight: 600;
		color: var(--deep-navy);
	}

	nav {
		display: flex;
		align-items: center;
		gap: clamp(20px, 2.25vw, 42px);
	}

	.nav-link {
		position: relative;
		padding: 44px 0 39px;
		text-decoration: none;
		text-transform: uppercase;
		font-size: 0.77rem;
		font-weight: 700;
		letter-spacing: 0.085em;
		color: var(--deep-navy);
	}

	.nav-link::after {
		position: absolute;
		right: 0;
		bottom: 30px;
		left: 0;
		height: 2px;
		background: var(--gold);
		content: "";
		opacity: 0;
		transform: scaleX(0.4);
		transition: 180ms ease;
	}

	.nav-link:hover::after,
	.nav-link.active::after {
		opacity: 1;
		transform: scaleX(1);
	}

	.menu-button {
		display: none;
		width: 44px;
		height: 44px;
		padding: 10px;
		border: 0;
		background: transparent;
	}

	.menu-button span {
		display: block;
		height: 2px;
		margin: 5px 0;
		background: var(--navy);
	}

	main {
		width: min(1480px, calc(100% - 48px));
		margin: 0 auto;
	}

	.hero {
		position: relative;
		min-height: clamp(520px, 66vh, 720px);
		overflow: hidden;
		border-radius: 4px;
		background: var(--navy);
		box-shadow: 0 20px 60px rgba(3, 29, 51, 0.15);
		isolation: isolate;
	}

	.hero-image,
	.hero-shade {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
	}

	.hero-image {
		z-index: -2;
		object-fit: cover;
		object-position: 50% 68%;
	}

	.hero-shade {
		z-index: -1;
		background:
			linear-gradient(90deg, rgba(0, 18, 34, 0.88) 0%, rgba(0, 23, 42, 0.66) 37%, rgba(0, 24, 44, 0.12) 72%),
			linear-gradient(0deg, rgba(0, 15, 28, 0.28), transparent 55%);
	}

	.hero-content {
		display: flex;
		min-height: inherit;
		width: min(660px, 56%);
		padding: clamp(64px, 8vw, 112px) clamp(34px, 5vw, 80px);
		flex-direction: column;
		align-items: flex-start;
		justify-content: center;
		color: white;
		text-shadow: 0 2px 18px rgba(0, 0, 0, 0.28);
	}

	.eyebrow {
		margin: 0 0 8px;
		text-transform: uppercase;
		font-size: 0.8rem;
		font-weight: 700;
		letter-spacing: 0.22em;
		color: #f5d296;
	}

	h1 {
		margin: 0;
		font-family: Georgia, "Times New Roman", serif;
		font-size: clamp(3.6rem, 6vw, 6.1rem);
		font-weight: 700;
		font-style: italic;
		line-height: 0.95;
		letter-spacing: -0.035em;
		transform: skewX(-4deg);
		transform-origin: left center;
	}

	.script {
		margin: 18px 0 0;
		text-transform: uppercase;
		font-family: "Avenir Next", Avenir, "Helvetica Neue", Arial, sans-serif;
		font-size: clamp(0.75rem, 1.25vw, 0.95rem);
		font-weight: 700;
		line-height: 1.5;
		letter-spacing: 0.22em;
		color: #f5d296;
	}

	.gold-rule {
		width: 42px;
		height: 3px;
		margin: 28px 0 20px;
		background: var(--gold);
	}

	.intro {
		margin: 0;
		font-size: clamp(1rem, 1.5vw, 1.28rem);
		line-height: 1.65;
	}

	.primary-button {
		display: inline-flex;
		align-items: center;
		gap: 13px;
		margin-top: 30px;
		padding: 16px 24px;
		border: 1px solid rgba(255, 255, 255, 0.85);
		text-decoration: none;
		text-transform: uppercase;
		font-size: 0.78rem;
		font-weight: 800;
		letter-spacing: 0.12em;
		background: rgba(4, 40, 69, 0.9);
		box-shadow: 0 8px 24px rgba(0, 0, 0, 0.18);
		transition: 180ms ease;
	}

	.primary-button:hover {
		background: var(--gold);
		transform: translateY(-2px);
	}

	.primary-button span {
		font-size: 1.2rem;
	}

	.journey-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: clamp(20px, 2.5vw, 38px);
		padding: 64px 10px 90px;
	}

	.panel {
		min-width: 0;
	}

	.panel-heading {
		min-height: 92px;
		text-align: center;
	}

	.panel-heading p {
		margin: 0;
		font-family: "Snell Roundhand", "Brush Script MT", cursive;
		font-size: 1.5rem;
		line-height: 1;
		color: var(--navy);
	}

	.panel-heading h2 {
		margin: 5px 0 22px;
		font-family: Georgia, "Times New Roman", serif;
		font-size: clamp(1.55rem, 2.3vw, 2.45rem);
		line-height: 1;
		letter-spacing: 0.035em;
		color: var(--navy);
	}

	.story-card,
	.video-card,
	.weather-card {
		height: 520px;
		overflow: hidden;
		border: 1px solid rgba(8, 43, 74, 0.11);
		border-radius: 4px;
		background: #fff;
		box-shadow: 0 12px 35px rgba(3, 29, 51, 0.08);
	}

	.story-image {
		position: relative;
		height: 245px;
		overflow: hidden;
	}

	.story-image img,
	.video-image img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.story-image img {
		object-position: 22% 28%;
	}

	.story-image > span {
		position: absolute;
		top: 0;
		left: 0;
		padding: 9px 13px;
		text-transform: uppercase;
		font-size: 0.67rem;
		font-weight: 800;
		letter-spacing: 0.08em;
		color: white;
		background: var(--navy);
	}

	.story-copy {
		display: flex;
		height: 275px;
