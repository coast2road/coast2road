---
import { logbookEntries } from '../../data/logbook';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content="Explore the Coast2Road Logbook—stories from the water, the road, and the places in between." />
		<link rel="canonical" href="https://coast2road.pages.dev/logbook/" />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Coast2Road" />
		<meta property="og:title" content="The Logbook | Coast2Road" />
		<meta property="og:description" content="Stories from the water, the road, and the places in between." />
		<meta property="og:url" content="https://coast2road.pages.dev/logbook/" />
		<meta property="og:image" content="https://coast2road.pages.dev/images/elcano-at-texas-am.jpg" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content="The Logbook | Coast2Road" />
		<meta name="twitter:description" content="Stories from the water, the road, and the places in between." />
		<meta name="twitter:image" content="https://coast2road.pages.dev/images/elcano-at-texas-am.jpg" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>The Logbook | Coast2Road</title>
	</head>
	<body>
		<header class="site-header">
			<a class="brand" href="/" aria-label="Coast2Road home">
				<img src="/images/coast2road-logo.svg" alt="" />
				<span><strong>coast<span>2</span>road</strong><em>The Journey Matters</em></span>
			</a>
			<a class="back-link" href="/"><span aria-hidden="true">←</span> Back home</a>
		</header>

		<main>
			<header class="logbook-header">
				<p>From the coast to the road</p>
				<h1>The Logbook</h1>
				<span></span>
				<p class="intro">Stories from life on the water, travels on the road, and the discoveries that happen in between.</p>
			</header>

			<section class="story-grid" aria-label="Coast2Road stories">
				{logbookEntries.map((entry, index) => (
					<article class:list={['story-card', { featured: index === 0 }]}>
						<a class="story-image" href={entry.href} aria-label={`Read ${entry.title}`}>
							<img src={entry.image} alt={entry.imageAlt} />
							<span>{entry.category}</span>
						</a>
						<div class="story-copy">
							<p class="location">● {entry.location}</p>
							<h2><a href={entry.href}>{entry.title}</a></h2>
							<p>{entry.summary}</p>
							<div class="meta">
								<span>{entry.dateLabel}</span>
								<span>{entry.readTime}</span>
								<a href={entry.href} aria-label={`Read ${entry.title}`}>Read story <b aria-hidden="true">→</b></a>
							</div>
						</div>
					</article>
				))}
			</section>

			<section class="logbook-end">
				<img src="/images/coast2road-compass.svg" alt="" />
				<p><span>More journeys ahead</span>New stories will appear here as the logbook grows.</p>
			</section>
		</main>

		<footer class="site-footer">
			<p>© 2026 coast2road</p>
			<a href="/about/">Our Story</a>
			<a href="mailto:info@coast2road.com">info@coast2road.com</a>
		</footer>
	</body>
</html>

<style is:global>
	:root { --navy:#082b4a; --deep-navy:#021b31; --gold:#c99135; --paper:#f7f5f0; --ink:#10273e; }
	* { box-sizing:border-box; }
	body { margin:0; color:var(--ink); background:radial-gradient(circle at 50% 0,rgba(201,145,53,.08),transparent 30rem),var(--paper); font-family:"Avenir Next",Avenir,"Helvetica Neue",Arial,sans-serif; }
	a { color:inherit; }
	.site-header { display:flex; align-items:center; justify-content:space-between; width:min(1180px,calc(100% - 48px)); min-height:108px; margin:auto; gap:24px; }
	.brand { display:inline-flex; align-items:center; gap:11px; text-decoration:none; }
	.brand img { width:68px; height:68px; }
	.brand > span { display:flex; flex-direction:column; line-height:1; }
	.brand strong { font-family:Georgia,serif; font-size:1.7rem; font-style:italic; color:var(--navy); transform:skewX(-4deg); }
	.brand strong span { color:var(--gold); }
	.brand em { margin-top:7px; font-family:"Snell Roundhand","Brush Script MT",cursive; font-size:.9rem; font-weight:600; color:var(--gold); }
	.back-link { text-decoration:none; text-transform:uppercase; font-size:.7rem; font-weight:800; letter-spacing:.1em; color:var(--navy); }
	.back-link span { margin-right:8px; color:var(--gold); }
	main { width:min(1180px,calc(100% - 48px)); margin:auto; }
	.logbook-header { max-width:760px; margin:55px auto 70px; text-align:center; }
	.logbook-header > p:first-child { margin:0 0 10px; text-transform:uppercase; font-size:.7rem; font-weight:800; letter-spacing:.18em; color:var(--gold); }
	h1 { margin:0; font-family:Georgia,serif; font-size:clamp(3.4rem,7vw,6.4rem); font-weight:400; line-height:1; color:var(--navy); }
	.logbook-header > span { display:block; width:46px; height:3px; margin:25px auto; background:var(--gold); }
	.intro { margin:0; font-family:Georgia,serif; font-size:1.2rem; line-height:1.7; color:#536779; }
	.story-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:38px; }
	.story-card { overflow:hidden; border:1px solid rgba(8,43,74,.11); border-radius:4px; background:white; box-shadow:0 12px 35px rgba(3,29,51,.08); }
	.story-image { position:relative; display:block; height:370px; overflow:hidden; }
	.story-image img { width:100%; height:100%; object-fit:cover; transition:transform 400ms ease; }
	.story-image:hover img { transform:scale(1.025); }
	.story-image > span { position:absolute; top:0; left:0; padding:9px 13px; text-transform:uppercase; font-size:.65rem; font-weight:800; letter-spacing:.1em; color:white; background:var(--navy); }
	.story-copy { padding:28px 30px 30px; }
	.location { margin:0 0 11px; text-transform:uppercase; font-size:.64rem; font-weight:800; letter-spacing:.09em; color:var(--gold); }
	.story-copy h2 { margin:0; font-family:Georgia,serif; font-size:clamp(1.65rem,3vw,2.2rem); font-weight:400; line-height:1.16; color:var(--navy); }
	.story-copy h2 a { text-decoration:none; }
	.story-copy > p:not(.location) { min-height:54px; margin:15px 0 22px; font-family:Georgia,serif; font-size:1rem; line-height:1.7; color:#40566a; }
	.meta { display:flex; align-items:center; gap:14px; padding-top:18px; border-top:1px solid #e2e4e4; text-transform:uppercase; font-size:.61rem; font-weight:800; letter-spacing:.07em; color:#728290; }
	.meta a { margin-left:auto; text-decoration:none; color:var(--navy); }
	.meta b { margin-left:5px; font-size:1rem; color:var(--gold); }
	.logbook-end { display:flex; align-items:center; justify-content:center; margin:90px auto; gap:17px; text-align:left; }
	.logbook-end img { width:64px; height:64px; }
	.logbook-end p { display:flex; margin:0; flex-direction:column; font-family:Georgia,serif; font-size:1rem; line-height:1.5; color:#536779; }
	.logbook-end span { text-transform:uppercase; font-family:"Avenir Next",sans-serif; font-size:.62rem; font-weight:800; letter-spacing:.12em; color:var(--gold); }
	.site-footer { display:flex; justify-content:center; padding:30px 24px; gap:30px; font-size:.7rem; color:#b9c7d0; background:var(--deep-navy); }
	.site-footer p { margin:0; }
	.site-footer a { text-decoration:none; }
	@media (max-width:720px) {
		.site-header { width:calc(100% - 30px); min-height:88px; }
		.brand img { width:52px; height:52px; }
		.brand strong { font-size:1.25rem; }
		.brand em { font-size:.75rem; }
		.back-link { font-size:0; }
		.back-link span { font-size:1.4rem; }
		main { width:calc(100% - 30px); }
		.logbook-header { margin:42px auto 52px; }
		.story-grid { grid-template-columns:1fr; gap:28px; }
		.story-image { height:320px; }
		.story-copy { padding:24px; }
		.story-copy > p:not(.location) { min-height:0; }
		.meta { flex-wrap:wrap; }
		.meta a { width:100%; margin:3px 0 0; }
		.site-footer { flex-wrap:wrap; gap:12px 24px; }
	}
</style>
