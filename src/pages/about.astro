	.motto > span { display: block; width: 45px; height: 3px; margin: 25px auto 28px; background: var(--gold); }
	blockquote { margin: 0; font-family: Georgia, serif; font-size: clamp(1.35rem, 2.4vw, 1.85rem); font-style: italic; line-height: 1.6; color: var(--navy); }
	.motto > p:not(:first-child) { margin: 22px auto 30px; font-family: Georgia, serif; font-size: 1.05rem; line-height: 1.7; color: #536779; }
