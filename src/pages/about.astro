		.compass-wrap { min-height: 160px; border-right: 0; border-bottom: 1px solid rgba(255,255,255,.18); }
		.compass-wrap img { width: 130px; }
		.motto { padding-bottom: 80px; }
		.site-footer, .site-footer > div { flex-direction: column; text-align: center; }
