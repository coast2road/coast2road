	.section-label span { width: 36px; height: 2px; margin-top: 5px; flex: 0 0 auto; background: var(--gold); }
	.section-label p, .kicker, .motto > p:first-child { margin: 0; text-transform: uppercase; font-size: .65rem; font-weight: 800; line-height: 1.5; letter-spacing: .13em; color: #667a8b; }
