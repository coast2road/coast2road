		.about-hero { min-height: 560px; }
		.hero-copy { width: calc(100% - 36px); padding-bottom: 42px; }
		.introduction { grid-template-columns: 1fr; width: calc(100% - 38px); padding: 65px 0 50px; gap: 30px; }
		.perspectives { grid-template-columns: 1fr; width: calc(100% - 38px); margin-bottom: 70px; }
		.perspectives article, .perspectives article + article { padding: 38px 0; border-left: 0; }
		.perspectives article + article { border-top: 1px solid #d7d6d0; }
